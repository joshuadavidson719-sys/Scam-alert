{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter @workspace/api-server run build:vercel && pnpm --filter @workspace/scam-alert exec expo export --platform web",
  "outputDirectory": "artifacts/scam-alert/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "includeFiles": "artifacts/api-server/dist/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
  ]
}
