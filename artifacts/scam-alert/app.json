{
  "expo": {
    "name": "ScamAlert App",
    "slug": "scam-alert",
    "version": "1.0.4",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "scamalert",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#00B09B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spicetech.scamalert",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Scam Alert to use your camera.",
        "NSPhotoLibraryUsageDescription": "Allow Scam Alert to access photos for your profile picture and to attach images or videos to posts."
      }
    },
    "android": {
      "package": "com.spicetech.scamalert",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#00B09B"
      },
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "scam-alert-api-server.vercel.app"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://scam-alert-api-server.vercel.app"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-asset",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Scam Alert to use your microphone to record voice notes.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": false
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Scam Alert to access photos for your profile picture and to attach images or videos to posts.",
          "cameraPermission": "Allow Scam Alert to use your camera."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#FF3B3B",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#00B09B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://scam-alert-api-server.vercel.app",
      "eas": {
        "projectId": "f2d37f46-6661-493f-a937-844ff302ad07"
      },
      "firebaseConfig": {
        "apiKey": "AIzaSyCn0Rc4xWW-0LaGhJuIBtZMLsBcsD7KnqI",
        "authDomain": "applicationid-scamalert-clean.firebaseapp.com",
        "projectId": "applicationid-scamalert-clean",
        "storageBucket": "applicationid-scamalert-clean.firebasestorage.app",
        "messagingSenderId": "86631393939",
        "appId": "1:86631393939:web:3a359e5c70bee0c8d7bb66"
      }
    }
  }
}
